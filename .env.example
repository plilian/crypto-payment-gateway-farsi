# کلید API محدود به فروشگاه که از داشبورد TheyPaid دریافت می‌شود.
# اختیاری است؛ اگر از فرایند اتصال حساب و ساخت کلید در MCP استفاده می‌کنید،
# این مقدار را در گفت‌وگو نفرستید و کلید واقعی را در مخزن ثبت نکنید.
THEYPAID_API_KEY=

# اطلاعات ورود ایمیل و گذرواژه برای ثبت‌نام یا ورود.
# آن‌ها را فقط در محیط امن میزبان MCP تنظیم کنید، نه به‌عنوان ورودی ابزار.
THEYPAID_ACCOUNT_EMAIL=
THEYPAID_ACCOUNT_PASSWORD=

# توکن داشبورد موجود برای برخی درخواست‌های حساب.
# راه‌اندازی کامل داشبورد به نشست ایجادشده با ورود ایمیل و گذرواژه نیاز دارد.
THEYPAID_ACCESS_TOKEN=

# کد یک‌بارمصرف ورود دومرحله‌ای؛ بهتر است برای هر ورود از ابزار MCP استفاده کنید.
# سرور این مقدار را پس از استفاده نگه نمی‌دارد.
THEYPAID_2FA_CODE=

# برای محدودکردن کلید THEYPAID_API_KEY به فروشگاه مشخص.
THEYPAID_STORE_ID=

# فقط برای ساخت کیف‌پول محلی رمزگذاری‌شده از دارایی‌های پشتیبانی‌شده لازم است.
# آن را در Secret Store محلی یا تنظیمات خصوصی MCP قرار دهید.
THEYPAID_WALLET_PASSWORD=

# مسیر پیش‌فرض: ~/.theypaid-ai/wallets
THEYPAID_WALLET_DIR=
